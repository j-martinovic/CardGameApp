# CardGameApp — Environment Variables
# Copy this file to .env and fill in values before starting the servers.
# None of these are secrets for local development — the defaults work out of the box.

# ── Flask (port 5000) ─────────────────────────────────────────────────────────
# No env vars needed for Flask in local development.
# Flask runs on port 5000 by default (set in config.py via app.run()).

# ── boardgame.io server (port 8000) ──────────────────────────────────────────
BGIO_PORT=8000

# Origins the boardgame.io server allows cross-origin requests from.
# Comma-separated list. Include both the game client and the existing SPA.
BGIO_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── game-client (port 3000) ───────────────────────────────────────────────────
# These are read by Vite at build time — they MUST start with VITE_ to be
# available in browser code.

# URL of the boardgame.io server (used by LobbyAPI and the game client).
VITE_BGIO_SERVER_URL=http://localhost:8000

# URL of the Flask API (used if the game client ever calls Flask directly).
VITE_FLASK_API_URL=http://localhost:5000

# ── Notes ─────────────────────────────────────────────────────────────────────
# Flask API port: 5000 (never changes — see backend/main_server/config.py)
# Existing SPA port: 5173 (Vite default — see frontend/vite.config.js)
# boardgame.io server port: 8000 (see game-server/server.js)
# Game client port: 3000 (see game-client/vite.config.js)
